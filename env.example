# Copiar a .env y ajustar los valores para el entorno local.

# URL base del backend, sin barra final e incluyendo el prefijo /api.
# Vacía en desarrollo: las peticiones pasan por el proxy de Vite
# (/api -> http://localhost:3000), que evita CORS.
# Con valor: las peticiones van directo a esa URL y el backend debe
# permitir el origen del frontend (CORS).
# En Heroku no se usa este archivo: se define como config var del build.
# Ejemplo: VITE_API_URL=https://proyecto3-back.herokuapp.com/api
VITE_API_URL=
